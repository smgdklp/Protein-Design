/round/bin/
/round/build/
/round/datebase/
/tool/result/
*.exe
*.dll
*.pyd

# ---------------------------------------------------------- 6. 缓存 / 临时 / 压缩包
.dsh-acl-recovery/
.cache/
hf_cache/
